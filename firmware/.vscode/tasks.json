{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LumaFlow: Configure",
            "type": "cmake",
            "command": "configure",
            "preset": "${command:cmake.activeConfigurePresetName}",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "LumaFlow: Build",
            "type": "cmake",
            "command": "build",
            "preset": "${command:cmake.activeBuildPresetName}",
            "targets": ["LumaFlow"],
            "dependsOn": ["LumaFlow: Configure"],
            "dependsOrder": "sequence",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "LumaFlow: Check debug config",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/check-debug.ps1"
            ],
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "LumaFlow: Flash",
            "type": "process",
            "command": "${config:lumaflow.openocdPath}",
            "args": [
                "-f", "${config:lumaflow.openocdConfig}",
                "-c", "program {${command:cmake.getLaunchTargetPath}} verify reset exit"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": ["LumaFlow: Check debug config", "LumaFlow: Build"],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "LumaFlow: Prepare debug",
            "dependsOn": ["LumaFlow: Check debug config", "LumaFlow: Build"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
