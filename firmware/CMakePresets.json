{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
                "CMAKE_DEFAULT_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Application",
            "inherits": "default",
            "cacheVariables": { "LUMAFLOW_IMAGE": "application" }
        },
        {
            "name": "Bootloader",
            "inherits": "default",
            "cacheVariables": { "LUMAFLOW_IMAGE": "bootloader" }
        }
    ],
    "buildPresets": [
        {
            "name": "Application-Debug",
            "displayName": "Debug",
            "configurePreset": "Application",
            "configuration": "Debug"
        },
        {
            "name": "Application-Release",
            "displayName": "Release",
            "configurePreset": "Application",
            "configuration": "Release"
        },
        {
            "name": "Bootloader-Debug",
            "displayName": "Debug",
            "configurePreset": "Bootloader",
            "configuration": "Debug"
        },
        {
            "name": "Bootloader-Release",
            "displayName": "Release",
            "configurePreset": "Bootloader",
            "configuration": "Release"
        }
    ]
}
